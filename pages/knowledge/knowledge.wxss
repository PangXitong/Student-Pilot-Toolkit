page {
  background-color: #ffffff;
  height: 100vh;
}

.page-container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background-color: #ffffff;
}

/* 知识点选择按钮 */
.picker-bar {
  padding: 20rpx 40rpx 24rpx;
  border-bottom: 1rpx solid #e9e9eb;
}

.picker-btn {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 28rpx;
  border-radius: 16rpx;
  background-color: #f5f5f7;
  border: 2rpx solid #e0e0e0;
}

.picker-btn-text {
  font-size: 28rpx;
  color: #333;
}

.picker-arrow {
  font-size: 22rpx;
  color: #86868b;
}

/* 弹窗遮罩 */
.picker-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.4);
  z-index: 300;
  display: flex;
  justify-content: center;
  align-items: center;
}

.picker-modal {
  width: 600rpx;
  background-color: #ffffff;
  border-radius: 24rpx;
  overflow: hidden;
}

.picker-modal-title {
  padding: 32rpx 32rpx 16rpx;
  font-size: 34rpx;
  font-weight: 600;
  color: #1d1d1f;
  text-align: center;
}

.picker-option {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 40rpx;
  border-bottom: 1rpx solid #f5f5f7;
}

.picker-option.active {
  background-color: #e8f0fe;
}

.picker-option-text {
  font-size: 28rpx;
  color: #333;
}

.picker-check {
  font-size: 28rpx;
  color: #007aff;
  font-weight: 600;
}

.picker-cancel {
  padding: 24rpx;
  text-align: center;
  font-size: 28rpx;
  color: #007aff;
  font-weight: 500;
  border-top: 1rpx solid #f5f5f7;
}

.picker-source {
  padding: 16rpx 32rpx 24rpx;
  text-align: center;
  background-color: #f9f9fb;
}

.picker-source-text {
  display: block;
  font-size: 20rpx;
  color: #b0b0b0;
  line-height: 1.6;
}

/* 加载中 */
.loading-area {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 160rpx 0;
}

.loading-text {
  font-size: 28rpx;
  color: #86868b;
}

/* 内容布局 */
.content-layout {
  display: flex;
  flex-direction: column;
  flex: 1;
  overflow: hidden;
}

/* 目录区域（上方） */
.toc-area {
  flex-shrink: 0;
  max-height: 400rpx;
  border-bottom: 1rpx solid #e9e9eb;
  background-color: #f9f9fb;
}

.toc-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 24rpx 16rpx;
}

.toc-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1d1d1f;
}

.toc-header-actions {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.toc-collapse-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 48rpx;
  height: 48rpx;
  border-radius: 8rpx;
  background-color: #e8e8e8;
  font-size: 20rpx;
  color: #666;
}

.toc-scroll {
  max-height: 300rpx;
  padding: 0 16rpx 16rpx;
}

.favorites-btn {
  display: flex;
  align-items: center;
  padding: 8rpx 0;
  font-size: 24rpx;
  color: #007aff;
}

.favorites-btn-icon {
  font-size: 28rpx;
  margin-right: 6rpx;
}

/* 树节点 */
.tree-node-row {
  display: flex;
  align-items: center;
  padding-top: 16rpx;
  padding-bottom: 16rpx;
  padding-right: 16rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.tree-node-row:active {
  background-color: #f0f0f5;
}

.tree-node-row.active {
  background-color: #e8f0fe;
  border-left: 4rpx solid #007aff;
}

.tree-arrow {
  font-size: 16rpx;
  color: #86868b;
  margin-right: 8rpx;
  flex-shrink: 0;
  transition: transform 0.2s;
  width: 24rpx;
  text-align: center;
}

.tree-arrow.expanded {
  transform: rotate(90deg);
}

.tree-arrow.leaf {
  color: #ccc;
  font-size: 14rpx;
  transform: none;
}

.tree-node-title {
  font-size: 28rpx;
  color: #333;
  line-height: 1.5;
  flex: 1;
}

.tree-star {
  font-size: 18rpx;
  color: #FFD700;
  margin-left: 6rpx;
  flex-shrink: 0;
}

/* 主内容区 */
.main-content {
  flex: 1;
  height: 0;
  padding: 24rpx;
  box-sizing: border-box;
}

.content-card {
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 32rpx;
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.06);
}

.content-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 24rpx;
  padding-bottom: 16rpx;
  border-bottom: 2rpx solid #f0f0f0;
}

.content-topic-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #1d1d1f;
  flex: 1;
  line-height: 1.4;
}

.favorite-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 8rpx 16rpx;
  border-radius: 12rpx;
  background-color: #f5f5f7;
  flex-shrink: 0;
  margin-left: 16rpx;
}

.favorite-btn.active {
  background-color: #FFD700;
}

.favorite-star {
  font-size: 36rpx;
  color: #c0c0c0;
}

.favorite-btn.active .favorite-star {
  color: #fff;
}

.favorite-label {
  font-size: 20rpx;
  color: #86868b;
  margin-top: 4rpx;
}

.favorite-btn.active .favorite-label {
  color: #fff;
}

.content-body {
  padding: 16rpx 0;
}

.content-text {
  font-size: 28rpx;
  color: #333;
  line-height: 1.8;
  white-space: pre-wrap;
  word-break: break-word;
}

.content-paragraph {
  display: block;
  font-size: 32rpx;
  color: #333;
  line-height: 1.8;
  text-indent: 2em;
  margin-bottom: 16rpx;
  word-break: break-word;
}

/* 翻页 */
.pagination {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 0 16rpx;
  border-top: 1rpx solid #f0f0f0;
  margin-top: 16rpx;
}

.page-btn {
  padding: 12rpx 24rpx;
  border-radius: 12rpx;
  background-color: #f5f5f7;
}

.page-btn.next {
  background-color: #007aff;
}

.page-btn.next .page-btn-text {
  color: #ffffff;
}

.page-btn-text {
  font-size: 24rpx;
  color: #333;
}

.page-info {
  font-size: 24rpx;
  color: #86868b;
}

.content-empty {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 80rpx 0;
  font-size: 28rpx;
  color: #86868b;
}

/* 来源标注 */
.source-area {
  padding: 40rpx 0 80rpx;
  text-align: center;
}

.source-text {
  display: block;
  font-size: 22rpx;
  color: #b0b0b0;
  line-height: 1.6;
}

.empty-placeholder {
  flex: 1;
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 80rpx 0;
  font-size: 28rpx;
  color: #86868b;
}

/* 收藏夹遮罩 */
.favorites-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.4);
  z-index: 200;
  display: flex;
  justify-content: center;
  align-items: center;
}

.favorites-panel {
  width: 660rpx;
  max-height: 80vh;
  background-color: #ffffff;
  border-radius: 24rpx;
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

.favorites-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 32rpx;
  border-bottom: 1rpx solid #e9e9eb;
}

.favorites-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1d1d1f;
}

.favorites-close {
  padding: 8rpx;
}

.close-icon {
  font-size: 36rpx;
  color: #86868b;
}

.favorites-list {
  flex: 1;
  padding: 16rpx 0;
  max-height: 600rpx;
}

.favorite-item {
  padding: 20rpx 32rpx;
  border-bottom: 1rpx solid #f5f5f7;
}

.fav-item-header {
  display: flex;
  align-items: center;
  margin-bottom: 6rpx;
}

.fav-star {
  font-size: 24rpx;
  color: #FFD700;
  margin-right: 8rpx;
}

.fav-chapter {
  font-size: 22rpx;
  color: #86868b;
}

.fav-title {
  font-size: 26rpx;
  color: #333;
  line-height: 1.4;
  display: block;
}

.favorites-empty {
  padding: 80rpx 0;
  text-align: center;
  font-size: 28rpx;
  color: #86868b;
}
