<view class="page-container">
  <!-- 知识点选择按钮 -->
  <view class="picker-bar">
    <view class="picker-btn" bindtap="openPicker">
      <text class="picker-btn-text">{{categoryLabel || '点击选择知识点'}}</text>
      <text class="picker-arrow">▼</text>
    </view>
  </view>

  <!-- 选择弹窗遮罩 -->
  <view class="picker-overlay" wx:if="{{showPicker}}" bindtap="closePicker">
    <view class="picker-modal" catchtap="">
      <view class="picker-modal-title">选择知识点</view>
      <view
        class="picker-option {{currentCategory === item.key ? 'active' : ''}}"
        wx:for="{{categories}}"
        wx:key="key"
        data-key="{{item.key}}"
        data-label="{{item.label}}"
        bindtap="confirmCategory"
      >
        <text class="picker-option-text">{{item.label}}</text>
        <text class="picker-check" wx:if="{{currentCategory === item.key}}">✓</text>
      </view>
      <view class="picker-cancel" bindtap="closePicker">取消</view>
      <view class="picker-source">
        <text class="picker-source-text">知识点来源于飞行人员信息咨询 pilot.caac.gov.cn</text>
        <text class="picker-source-text">庞玺桐整理格式，若有问题欢迎反馈</text>
      </view>
    </view>
  </view>

  <!-- 加载中 -->
  <view class="loading-area" wx:if="{{loading}}">
    <view class="loading-text">加载中...</view>
  </view>

  <!-- 未选择知识点时的空状态 -->
  <view class="empty-placeholder" wx:if="{{!loaded && !loading && !showFavorites}}">
    <text>请在上方选择知识点加载</text>
  </view>

  <!-- 内容区域（目录 + 内容） -->
  <block wx:if="{{loaded && !showFavorites}}">
    <view class="content-layout">
      <!-- 章节目录（上方树形） -->
      <view class="toc-area">
        <view class="toc-header">
          <text class="toc-title">章节目录</text>
          <view class="toc-header-actions">
            <view class="toc-collapse-btn" bindtap="toggleToc">
              <text>{{tocCollapsed ? '▶' : '▼'}}</text>
            </view>
            <view class="favorites-btn" bindtap="showFavoritesView">
              <text class="favorites-btn-icon">★</text>
              <text>收藏夹</text>
            </view>
          </view>
        </view>
        <scroll-view class="toc-scroll" scroll-y wx:if="{{!tocCollapsed}}">
          <view
            class="tree-node-row {{item.isLeaf && currentTopic && currentTopic.id === item.key ? 'active' : ''}}"
            wx:for="{{visibleNodes}}"
            wx:key="key"
            style="padding-left: {{item.level * 32 + 16}}rpx"
            data-key="{{item.key}}"
            bindtap="toggleTreeNode"
          >
            <!-- 展开箭头（叶子节点不显示箭头，显示圆点） -->
            <text class="tree-arrow leaf" wx:if="{{item.isLeaf}}">•</text>
            <text class="tree-arrow {{expandedKeys[item.key] ? 'expanded' : ''}}" wx:elif="{{item.level >= 0}}">▶</text>
            <text class="tree-node-title">{{item.key}} {{item.title}}</text>
            <!-- 收藏标记 -->
            <text class="tree-star" wx:if="{{item.hasContent && favorites[currentCategory] && favorites[currentCategory].indexOf(String(item.key)) > -1}}">★</text>
          </view>
        </scroll-view>
      </view>

      <!-- 主内容区（下方） -->
      <scroll-view class="main-content" scroll-y>
        <view class="content-card" wx:if="{{currentTopic}}">
          <view class="content-header">
            <text class="content-topic-title">{{currentTopic.id}} {{currentTopic.title}}</text>
            <view
              class="favorite-btn {{favorites[currentCategory] && favorites[currentCategory].indexOf(String(currentTopic.id)) > -1 ? 'active' : ''}}"
              data-topic-id="{{currentTopic.id}}"
              bindtap="toggleFavorite"
            >
              <text class="favorite-star">{{favorites[currentCategory] && favorites[currentCategory].indexOf(String(currentTopic.id)) > -1 ? '★' : '☆'}}</text>
              <text class="favorite-label">{{favorites[currentCategory] && favorites[currentCategory].indexOf(String(currentTopic.id)) > -1 ? '取消收藏' : '收藏'}}</text>
            </view>
          </view>
          <view class="content-body">
            <text class="content-paragraph" wx:for="{{contentParagraphs}}" wx:key="index">{{item}}</text>
          </view>
          <!-- 翻页 -->
          <view class="pagination">
            <view class="page-btn prev" bindtap="prevTopic">
              <text class="page-btn-text">◀ 上一页</text>
            </view>
            <text class="page-info">{{currentTopicIndex + 1}} / {{totalTopics}}</text>
            <view class="page-btn next" bindtap="nextTopic">
              <text class="page-btn-text">下一页 ▶</text>
            </view>
          </view>
        </view>
        <view class="content-empty" wx:else>
          <text>请在左侧目录中选择知识点</text>
        </view>

        <!-- 来源标注 -->
        <view class="source-area">
          <text class="source-text">知识点来源于飞行人员信息咨询 pilot.caac.gov.cn</text>
          <text class="source-text">庞玺桐整理格式，若有问题请以官方文件为主，欢迎反馈</text>
        </view>
      </scroll-view>
    </view>
  </block>

  <!-- 收藏夹视图 -->
  <view class="favorites-overlay" wx:if="{{showFavorites}}">
    <view class="favorites-panel">
      <view class="favorites-header">
        <text class="favorites-title">我的收藏</text>
        <view class="favorites-close" bindtap="closeFavorites">
          <text class="close-icon">✕</text>
        </view>
      </view>
      <scroll-view class="favorites-list" scroll-y>
        <view
          class="favorite-item"
          wx:for="{{favoriteTopics}}"
          wx:key="key"
          data-key="{{fav.key}}"
          bindtap="jumpToFavorite"
          wx:for-item="fav"
        >
          <view class="fav-item-header">
            <text class="fav-star">★</text>
            <text class="fav-chapter">{{fav.chapter_id}}</text>
          </view>
          <text class="fav-title">{{fav.id}} {{fav.title}}</text>
        </view>
        <view class="favorites-empty" wx:if="{{favoriteTopics.length === 0}}">
          <text>还没有收藏任何知识点</text>
        </view>
      </scroll-view>
    </view>
  </view>
</view>
