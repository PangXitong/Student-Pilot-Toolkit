﻿﻿﻿<!-- PEPEC.wxml - ICAO英语音频练习页面 -->
<view class="page">

  <!-- 顶部标题 
  <view class="header">
    <text class="header-title">ICAO英语音频练习</text>
  </view>-->

  <!-- 主内容区 -->
  <view class="main-area">

    <!-- 导入提示 -->
    <view class="import-tip">
      <text class="tip-text">确保手机关闭静音模式，报错需要清理缓存</text>
    </view>

    <!-- 导入按钮 -->
    <view class="import-section">
      <view class="import-buttons">
        <button class="import-btn primary" bindtap="onChooseFromChat">📁 导入MP3文件</button>
        <button class="import-btn primary" bindtap="onChooseZipFile">📦 导入ZIP文件</button>
        <button class="import-btn primary" bindtap="onImportOnline">🌐 使用线上资源</button>
      </view>
    </view>

    <!-- 练习模式选择 -->
    <view class="mode-section">
      <view class="mode-card {{playMode === 'sequence' ? 'active' : ''}}" bindtap="onToggleMode">
        <text class="mode-icon">🔁</text>
        <text class="mode-text">{{playModeText}}</text>
      </view>
      <view class="mode-card {{autoPlayNext ? 'active' : ''}}" bindtap="onToggleAutoPlay">
        <text class="mode-icon">🔂</text>
        <text class="mode-text">自动连播：{{autoPlayNext ? '开' : '关'}}</text>
      </view>
    </view>

    <!-- 当前播放和进度条 -->
    <view class="player-section">
      <text class="section-label">当前文件</text>
      <view class="current-file-name">{{currentFileDisplayName || currentFileName}}</view>
      <view class="progress-area">
        <text class="time-text">{{currentTimeText}}</text>
        <slider
          class="progress-slider"
          min="0" max="100"
          value="{{progress}}"
          activeColor="#1890ff"
          backgroundColor="#e8e8e8"
          block-size="14"
          bindchange="onProgressChange"
        />
        <text class="time-text">{{durationText}}</text>
      </view>
    </view>

    <!-- 播放控制按钮 -->
    <view class="control-section">
      <view class="control-btn favorite-btn" bindtap="onToggleFavorite">
        <text class="control-icon">{{isCurrentFavorite ? '⭐' : '☆'}}</text>
        <text class="control-label">{{isCurrentFavorite ? '已收藏' : '收藏'}}</text>
      </view>
      <view class="control-btn prev-btn" bindtap="onPrev">
        <text class="control-icon">⏮</text>
        <text class="control-label">上一个</text>
      </view>
      <view class="control-btn play-btn {{isPlaying ? 'playing' : ''}}" bindtap="onPlayPause">
        <text class="control-icon">{{isPlaying ? '⏸' : '▶️'}}</text>
        <text class="control-label">{{isPlaying ? '暂停' : '播放'}}</text>
      </view>
      <view class="control-btn next-btn" bindtap="onNext">
        <text class="control-icon">⏭</text>
        <text class="control-label">下一个</text>
      </view>
      <view class="control-btn speed-btn" bindtap="onToggleSpeedPicker">
        <text class="control-icon">⏩</text>
        <text class="control-label">{{playbackRate}}x</text>
      </view>
    </view>

    <!-- 倍速选择器 -->
    <view class="speed-picker-overlay {{showSpeedPicker ? 'show' : ''}}" bindtap="onCloseSpeedPicker">
      <view class="speed-picker-content" catchtap="stopPropagation">
        <view class="speed-picker-header">
          <text class="speed-picker-title">选择播放速度</text>
        </view>
        <picker-view 
          class="speed-picker-view"
          value="{{[speedIndex]}}"
          bindchange="onSpeedPickerChange"
        >
          <picker-view-column>
            <view wx:for="{{speedOptions}}" wx:key="index" class="picker-item">
              {{item}}x
            </view>
          </picker-view-column>
        </picker-view>
        <view class="speed-picker-footer">
          <button class="speed-picker-close-btn" bindtap="onCloseSpeedPicker">关闭</button>
        </view>
      </view>
    </view>

    <view class="file-list-section">
      <view class="file-list-header">
        <text class="section-label" bindtap="onToggleFileListMode">
          <text class="mode-text">{{fileListMode === 'all' ? '所有音频' : (fileListMode === 'favorite' ? '收藏夹' : '其他')}}</text>
          <text class="mode-count">({{fileListMode === 'all' ? audioList.length : (fileListMode === 'favorite' ? favoriteCount : otherCount)}})</text>
          <text class="arrow-icon">▼</text>
        </text>
        <input class="search-input" type="text" confirm-type="search" placeholder="搜索跳转" value="{{searchKeyword}}" bindinput="onSearchInput" bindconfirm="onSearchConfirm" />
        <text class="header-btn" bindtap="onImport">导入</text>
        <text class="header-btn" bindtap="onExport">导出</text>
        <text class="clear-btn" bindtap="onClearAll" wx:if="{{audioList.length > 0}}">清空</text>
      </view>
      <scroll-view class="file-list-scroll" scroll-y scroll-into-view="{{scrollIntoViewId}}" scroll-with-animation="{{true}}">
        <view
          wx:for="{{filteredAudioList}}"
          wx:key="name"
          class="file-item {{currentFileName === item.name ? 'active' : ''}} {{item.isFavorite ? 'favorite' : ''}}"
          id="file-item-{{index}}"
          data-index="{{index}}"
          bindtap="onFileItemTap"
        >
          <text class="file-index">{{index + 1}}.</text>
          <text class="file-name">{{item.displayName || item.name}}</text>
          <text class="file-favorite-icon" wx:if="{{item.isFavorite}}">⭐</text>
          <text class="file-play-icon" wx:if="{{currentFileName === item.name && isPlaying}}">▶</text>
          <text class="file-delete-btn" data-index="{{index}}" catchtap="onDeleteFile">×</text>
        </view>
        <view wx:if="{{filteredAudioList.length === 0}}" class="empty-hint">
          <text>{{fileListMode === 'all' ? '暂无文件，请点击上方按钮导入音频' : (fileListMode === 'favorite' ? '暂无收藏音频' : '暂无其他音频')}}</text>
        </view>
      </scroll-view>
    </view>

    <!-- 原文区域 -->
    <view class="text-section" wx:if="{{!sentenceLoaded && audioList.length > 0}}">
      <button class="fetch-text-btn" bindtap="onFetchText">获取原文</button>
    </view>
    <view class="text-section" wx:elif="{{sentenceLoaded}}">
      <text class="section-label">原文</text>
      <view class="text-content" wx:if="{{currentFileText}}">{{currentFileText}}</view>
      <view class="text-placeholder" wx:else>原文已加载，播放音频后显示</view>
    </view>

    <view class="mode-picker-overlay {{showModePicker ? 'show' : ''}}" bindtap="onCloseModePicker">
      <view class="mode-picker-content" catchtap="">
        <view class="mode-picker-header">
          <text class="mode-picker-title">选择显示模式</text>
        </view>
        <view class="mode-picker-options">
          <view class="mode-picker-option {{fileListMode === 'all' ? 'active' : ''}}" bindtap="onSelectMode" data-mode="all">
            <text class="mode-option-text">所有音频</text>
            <text class="mode-option-count">({{audioList.length}})</text>
            <text class="mode-option-check" wx:if="{{fileListMode === 'all'}}">✓</text>
          </view>
          <view class="mode-picker-option {{fileListMode === 'favorite' ? 'active' : ''}}" bindtap="onSelectMode" data-mode="favorite">
            <text class="mode-option-text">收藏夹</text>
            <text class="mode-option-count">({{favoriteCount}})</text>
            <text class="mode-option-check" wx:if="{{fileListMode === 'favorite'}}">✓</text>
          </view>
          <view class="mode-picker-option {{fileListMode === 'other' ? 'active' : ''}}" bindtap="onSelectMode" data-mode="other">
            <text class="mode-option-text">其他</text>
            <text class="mode-option-count">({{otherCount}})</text>
            <text class="mode-option-check" wx:if="{{fileListMode === 'other'}}">✓</text>
          </view>
        </view>
        <view class="mode-picker-footer">
          <text class="mode-picker-cancel" bindtap="onCloseModePicker">取消</text>
        </view>
      </view>
    </view>

    <!-- 录音模块 -->
    <view class="recording-section">
      <view class="recording-header">
        <text class="section-label">我的录音</text>
        <text class="clear-btn" bindtap="onClearRecordings" wx:if="{{recordingList.length > 0}}">清空</text>
      </view>

      <!-- 录音控制按钮 -->
      <view class="recording-controls">
        <view class="record-btn {{isRecording ? 'recording' : ''}}" bindtap="onStartStopRecord">
          <text class="record-icon">{{isRecording ? '⏹' : '🎤'}}</text>
          <text class="record-label">{{isRecording ? '停止录音' : '开始录音'}}</text>
        </view>
        <view class="play-recording-btn {{isPlayingRecording ? 'playing' : ''}}" bindtap="onTogglePlayRecording">
          <text class="play-recording-icon">{{isPlayingRecording ? '⏸' : '▶'}}</text>
          <text class="play-recording-label">{{isPlayingRecording ? '暂停播放' : '播放录音'}}</text>
        </view>
      </view>

      <!-- 录音播放进度条 -->
      <view class="recording-progress-section">
        <text class="recording-time-text">{{recordingCurrentTimeText}}</text>
        <slider
          class="recording-progress-slider"
          min="0"
          max="100"
          value="{{recordingProgress}}"
          activeColor="#1890ff"
          backgroundColor="#e8e8e8"
          block-size="14"
          bindchange="onRecordingProgressChange"
        />
        <text class="recording-time-text">{{recordingDurationText}}</text>
      </view>

      <!-- 录音列表 -->
      <scroll-view class="recording-list-scroll" scroll-y>
        <view
          wx:for="{{recordingList}}"
          wx:key="name"
          class="recording-item {{currentRecordingIndex === index ? 'active' : ''}}"
          data-index="{{index}}"
          bindtap="onRecordingItemTap"
        >
          <text class="recording-index">{{index + 1}}.</text>
          <text class="recording-name">{{item.name}}</text>
          <text class="recording-duration">{{item.duration || '0:00'}}</text>
          <text class="recording-play-icon" wx:if="{{currentRecordingIndex === index && isPlayingRecording}}">▶</text>
          <view class="recording-delete-btn" catchtap="onDeleteRecording" data-index="{{index}}">
            <text class="delete-icon">🗑️</text>
          </view>
        </view>
        <view wx:if="{{recordingList.length === 0}}" class="empty-hint">
          <text>暂无录音，点击上方按钮开始录音</text>
        </view>
      </scroll-view>
    </view>

  </view>

  <!-- 学号输入弹窗（已注释）
  <view class="modal-overlay {{showInputModal ? 'show' : ''}}" bindtap="onModalTap">
    <view class="modal-content">
      <view class="modal-header">
        <text class="modal-title">输入学号验证</text>
        <text class="modal-close" bindtap="onCloseModal">✕</text>
      </view>
      <view class="modal-body">
        <input 
          class="modal-input" 
          type="text" 
          placeholder="请输入学号" 
          maxlength="20"
          value="{{studentIdInput}}"
          bindinput="onStudentIdInput"
        />
      </view>
      <view class="modal-footer">
        <button class="modal-btn cancel" bindtap="onCloseModal">取消</button>
        <button class="modal-btn confirm" bindtap="onConfirmImport">确定</button>
      </view>
    </view>
  </view>
  -->

  <!-- 线上套资源提示弹窗 -->
  <view class="modal-overlay {{showInputModal ? 'show' : ''}}" bindtap="onModalTap">
    <view class="modal-content">
      <view class="modal-header">
        <text class="modal-title">提示</text>
        <text class="modal-close" bindtap="onCloseModal">✕</text>
      </view>
      <view class="modal-body">
        <text class="modal-text paragraph">仅获取文件列表，播放时再下载单条音频，不可离线使用。</text>
        <text class="modal-text paragraph">对于原文文本，您可以在飞行人员信息咨询pilot.caac.gov.cn的“语言能力等级测试信息”下的“语言能力等级测试备考信息”页面找到。</text>
      </view>
      <view class="modal-footer">
        <button class="modal-btn cancel" bindtap="onConfirmImport">CAAC原版</button>
        <button class="modal-btn confirm" bindtap="onConfirmImportSorted">排序版</button>
      </view>
    </view>
  </view>

</view>
