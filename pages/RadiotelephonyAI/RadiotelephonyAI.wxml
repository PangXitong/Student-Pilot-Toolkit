<!-- 云塔智联 · PEPEC 陆空通话情景训练 -->
<view class="page">
  <scroll-view class="scroll" scroll-y scroll-into-view="{{scrollIntoView}}" scroll-with-animation>

    <!-- 模型信息 -->
    <view class="model-card">
      <view class="mc-head">
        <view class="mc-name" bindtap="onCopyModelLink">{{modelName}}</view>
        <view class="tag">公开</view>
      </view>
      <view class="meta">
        <view class="meta-row"><view class="meta-dt">所有者</view><view class="meta-dd">庞玺桐（PangXitong）</view></view>
        <view class="meta-row"><view class="meta-dt">Licence</view><view class="meta-dd">apache-2.0</view></view>
        <view class="meta-row"><view class="meta-dt">模型描述</view><view class="meta-dd desc">只会说英语陆空通话的模型，扮演管制员，与飞行员（用户）进行对话，模拟PEPEC考试</view></view>
      </view>
      <view class="mc-actions">
        <view class="btn" bindtap="onCopyModelLink">前往 ModelScope 查看模型</view>
      </view>
    </view>

    <!-- 访问代码（白名单）：不验证也能看整个页面，只是接口会拒绝返回结果 -->
    <view class="panel">
      <view class="panel-title">访问代码</view>
      <view class="hint">此页面为内部工具，不开放公众使用，内部人员需要使用庞玺桐分发的访问代码进行验证，模型才会返回结果。验证通过后会记住在本机，下次进入无需重新验证。</view>

      <view class="auth-row">
        <input
          class="auth-input"
          type="text"
          placeholder="请输入访问代码"
          placeholder-class="gate-placeholder"
          value="{{codeInput}}"
          disabled="{{verifying}}"
          confirm-type="done"
          bindinput="onCodeInput"
          bindconfirm="onVerifyTap"
        />
        <view class="btn {{verifying ? 'btn-disabled' : ''}}" bindtap="onVerifyTap">
          {{verifying ? '验证中…' : (verified ? '更换代码' : '验证')}}
        </view>
      </view>

      <view class="auth-tip {{authTipBad ? 'bad' : (verified ? 'ok' : '')}}">{{authTip}}</view>

      <view class="auth-logout" wx:if="{{verified}}" bindtap="onLogout">退出验证</view>
    </view>

    <!-- 对话区 -->
    <view class="chat">
      <view class="chat-empty" wx:if="{{messages.length === 0}}">{{chatTip}}</view>

      <view
        class="msg {{item.role}} {{item.role === 'system' ? 'error' : ''}}"
        wx:for="{{messages}}"
        wx:key="id"
        id="msg-{{item.id}}"
      >
        <view class="role">
          {{item.role === 'user' ? '学员 / You' : (item.role === 'assistant' ? '管制 / ATC' : '系统提示')}}
        </view>
        <view class="reason" wx:if="{{item.reason}}" data-index="{{index}}" bindtap="onToggleReason">
          <view class="reason-summary">{{item.showReason ? '▾' : '▸'}} 思考过程</view>
          <view class="reason-body" wx:if="{{item.showReason}}">{{item.reason}}</view>
        </view>
        <view class="bubble">
          <!-- 等待模型返回：转圈占位 -->
          <view class="typing-dots" wx:if="{{item.pending}}">
            <view class="spinner"></view>
            <text class="spinner-text">AI 正在生成…</text>
          </view>
          <block wx:else>
            <text>{{item.text}}</text><text class="cursor" wx:if="{{item.typing}}"></text>
          </block>
        </view>
        <!-- 免责标注：贴在模型回复气泡的右下角 -->
        <view class="ai-note" wx:if="{{item.role === 'assistant'}}">内容由 AI 生成，仅供参考</view>
      </view>
    </view>

    <!-- 输入区 -->
    <view class="composer">
      <textarea
        class="composer-input"
        value="{{inputValue}}"
        placeholder="{{started ? '在此输入…' : '点击右侧开始按钮发送首条指令，即可在此输入'}}"
        placeholder-class="gate-placeholder"
        disabled="{{!canInput}}"
        auto-height
        maxlength="-1"
        cursor-spacing="20"
        bindinput="onInputChange"
      />
      <view class="btn btn-send {{canSend ? '' : 'btn-disabled'}}" bindtap="onSendTap">{{started ? '发送' : '开始'}}</view>
      <view class="btn ghost" wx:if="{{generating}}" bindtap="onStopTap">停止</view>
    </view>

    <view class="footer"></view>
  </scroll-view>
</view>
